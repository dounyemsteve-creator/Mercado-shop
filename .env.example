# ============================================================
# MERCADO SERVER
# ============================================================

PORT=10000

# URL publique de ton site/backend
PUBLIC_BASE_URL=https://YOUR-MERCADO-DOMAIN.onrender.com

# Autorisation CORS
CORS_ORIGIN=https://YOUR-MERCADO-DOMAIN.onrender.com


# ============================================================
# RESEND - EMAIL
# ============================================================

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

RESEND_FROM=MERCADO <noreply@YOUR-DOMAIN.com>


# ============================================================
# SMTP - OPTIONNEL
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN

TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID


# ============================================================
# eBay API
# ============================================================

EBAY_CLIENT_ID=YOUR_EBAY_CLIENT_ID

EBAY_CLIENT_SECRET=YOUR_EBAY_CLIENT_SECRET


# ============================================================
# GATEPAY.TO
# ============================================================

# API officielle GatePay.to
GATEPAY_TO_BASE_URL=https://api.gatepay.to

# Ton adresse de réception
# Exemple : ton adresse USDC Polygon
GATEPAY_TO_WALLET=YOUR_USDC_POLYGON_WALLET

# Devise utilisée pour le montant de la commande
GATEPAY_TO_CURRENCY=USD

# Secret utilisé pour sécuriser le callback
GATEPAY_TO_CALLBACK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# ============================================================
# TRADUCTION - OPTIONNEL
# ============================================================

DEEPL_API_KEY=

GOOGLE_TRANSLATE_API_KEY=


# ============================================================
# ADMIN
# ============================================================

ADMIN_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_ADMIN_KEY
