app.get(
  "/api/admin/orders",
  (req, res) => {
    if (
      !ADMIN_KEY ||
      !constantTimeEqual(
        req.headers["x-admin-key"],
        ADMIN_KEY
      )
    ) {
      return res.status(401).json({
        ok: false,
        error: "Unauthorized",
      });
    }

    res.json({
      ok: true,
      orders: readJson(
        ORDERS_FILE,
        []
      ),
    });
  }
);

