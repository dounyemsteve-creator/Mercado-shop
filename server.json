app.get("/api/products", async (req, res) => {
  try {
    const token =
      await getEbayAccessToken();

    const url =
      "https://api.ebay.com/buy/browse/v1/item_summary/search" +
      "?q=popular" +
      "&limit=24";

    const response = await fetch(url, {
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
        "X-EBAY-C-MARKETPLACE-ID":
          "EBAY_US",
      },
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data?.errors?.[0]?.message ||
          "eBay catalog request failed"
      );
    }

    res.json({
      ok: true,
      items: data.itemSummaries || [],
      total: data.total || 0,
    });
  } catch (error) {
    console.error(
      "PRODUCTS ERROR:",
      error
    );

    res.status(500).json({
      ok: false,
      error: error.message,
    });
  }
});

// ============================================================
// GATEPAY.TO
// ============================================================

function extractCheckoutUrl(data) {
  if (!data) return null;

  const candidates = [
    data.checkout_url,
    data.checkoutUrl,
    data.payment_url,
    data.paymentUrl,
    data.url,
    data.link,

    data.data?.checkout_url,
    data.data?.checkoutUrl,
    data.data?.payment_url,
    data.data?.paymentUrl,
    data.data?.url,
    data.data?.link,

    data.result?.checkout_url,
    data.result?.checkoutUrl,
    data.result?.payment_url,
    data.result?.paymentUrl,
    data.result?.url,
    data.result?.link,
  ];

  return (
    candidates.find(
      (value) =>
        typeof value === "string" &&
        value.startsWith("http")
    ) || null
  );
}

function normalizePaymentStatus(value) {
  const status = String(
    value || ""
  )
    .trim()
    .toLowerCase();

  if (
    [
      "paid",
      "success",
      "successful",
      "completed",
      "complete",
      "confirmed",
      "confirmed_payment",
    ].includes(status)
  ) {
    return "paid";
  }

  if (
    [
      "failed",
      "failure",
      "cancelled",
      "canceled",
      "expired",
      "rejected",
    ].includes(status)
  ) {
    return "failed";
  }

  return "pending";
}

async function createGatePayPayment({
  wallet,
  amount,
  currency,
  callback,
  orderId,
  email,
}) {
  if (!wallet) {
    throw new Error(
      "GatePay.to wallet is not configured"
    );
  }

  const response = await fetch(
    `${GATEPAY_TO_BASE_URL}/pay.php`,
    {
      method: "POST",

      headers: {
        "Content-Type":
          "application/json",
        Accept: "application/json",
      },

      body: JSON.stringify({
        wallet,
        amount,
        currency,
        callback,
        order_id: orderId,
        email,
      }),
    }
  );

  const rawText = await response.text();

  let data;

  try {
    data = JSON.parse(rawText);
  } catch {
    data = {
      raw: rawText,
    };
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
        data?.error ||
        `GatePay.to HTTP ${response.status}`
    );
  }

  const checkoutUrl =
    extractCheckoutUrl(data);

  if (!checkoutUrl) {
    console.error(
      "GatePay.to response:",
      data
    );

    throw new Error(
      "GatePay.to did not return a checkout URL"
    );
  }

  return {
    checkoutUrl,
    data,
  };
}

// ============================================================
// CREATE GATEPAY PAYMENT
// ============================================================

app.post(
  "/api/payment/gatepay",
  async (req, res) => {
    try {
      const {
        email,
        items,
        total,
        currency,
      } = req.body || {};

      const cleanEmail =
        normalizeEmail(email);

      if (
        !cleanEmail ||
        !validEmail(cleanEmail)
      ) {
        return res.status(400).json({
          ok: false,
          error: "Valid email is required",
        });
      }

      const amount = Number(total);

      if (
        !Number.isFinite(amount) ||
        amount <= 0
      ) {
        return res.status(400).json({
          ok: false,
          error: "Invalid payment amount",
        });
      }

      if (
        !Array.isArray(items) ||
        items.length === 0
      ) {
        return res.status(400).json({
          ok: false,
          error: "Payment items are required",
        });
      }

      if (!GATEPAY_TO_WALLET) {
        return res.status(500).json({
          ok: false,
          error:
            "GatePay.to wallet is not configured",
        });
      }

      if (!PUBLIC_BASE_URL) {
        return res.status(500).json({
          ok: false,
          error:
            "PUBLIC_BASE_URL is not configured",
        });
      }

      const merchantTradeNo =
        generateId("MERCADO_");

      const callback =
        `${PUBLIC_BASE_URL}` +
        `/api/payment/gatepay/callback`;

      const payment =
        await createGatePayPayment({
          wallet:
            GATEPAY_TO_WALLET,

          amount: amount.toFixed(2),

          currency:
            currency ||
            GATEPAY_TO_CURRENCY,

          callback,

          orderId:
            merchantTradeNo,

          email:
            cleanEmail,
        });

      const payments =
        readJson(
          PAYMENTS_FILE,
          []
        );

      const paymentRecord = {
        id:
          merchantTradeNo,

        merchantTradeNo,

        provider:
          "GatePay.to",

        email:
          cleanEmail,

        amount,

        currency:
          currency ||
          GATEPAY_TO_CURRENCY,

        items,

        checkoutUrl:
          payment.checkoutUrl,

        status:
          "pending",

        createdAt:
          new Date().toISOString(),

        updatedAt:
          new Date().toISOString(),
      };

      payments.push(
        paymentRecord
      );

      writeJson(
        PAYMENTS_FILE,
        payments
      );

      res.json({
        ok: true,

        provider:
          "GatePay.to",

        paymentId:
          merchantTradeNo,

        merchantTradeNo,

        checkoutUrl:
          payment.checkoutUrl,

        paymentUrl:
          payment.checkoutUrl,

        status:
          "pending",
      });
    } catch (error) {
      console.error(
        "GATEPAY CREATE ERROR:",
        error
      );

      res.status(500).json({
        ok: false,
        error: error.message,
      });
    }
  }
);

// ============================================================
// FINALIZE PAID ORDER
// ============================================================

async function finalizePaidOrder(
  payment
) {
  const orders =
    readJson(
      ORDERS_FILE,
      []
    );

  const existing =
    orders.find(
      (order) =>
        order.paymentId ===
        payment.paymentId
    );

  if (existing) {
    return existing;
  }

  const order = {
    id:
      generateId("order_"),

    paymentId:
      payment.paymentId,

    merchantTradeNo:
      payment.merchantTradeNo,

    provider:
      "GatePay.to",

    email:
      payment.email,

    amount:
      payment.amount,

    currency:
      payment.currency,

    items:
      payment.items || [],

    status:
      "paid",

    createdAt:
      new Date().toISOString(),
  };

  orders.push(order);

  writeJson(
    ORDERS_FILE,
    orders
  );

  // Telegram notification

  if (
    TELEGRAM_BOT_TOKEN &&
    TELEGRAM_CHAT_ID
  ) {
    try {
      await sendTelegramMessage(
        `💰 <b>MERCADO PAYMENT</b>\n\n` +
        `Status: <b>PAID</b>\n` +
        `Amount: <b>${payment.amount} ${payment.currency}</b>\n` +
        `Email: <code>${payment.email}</code>\n` +
        `Order: <code>${payment.merchantTradeNo}</code>`
      );
    } catch (error) {
      console.error(
        "Telegram payment notification error:",
        error.message
      );
    }
  }

  return order;
}

// ============================================================
// GATEPAY CALLBACK
// ============================================================

app.post(
  "/api/payment/gatepay/callback",
  async (req, res) => {
    try {
      if (
        GATEPAY_TO_CALLBACK_SECRET
      ) {
        const suppliedSecret =
          req.headers[
            "x-gatepay-secret"
          ] ||
          req.headers[
            "x-callback-secret"
          ] ||
          req.body?.secret ||
          req.body?.callback_secret;

        if (
          !constantTimeEqual(
            suppliedSecret,
            GATEPAY_TO_CALLBACK_SECRET
          )
        ) {
          return res.status(401).json({
            ok: false,
            error:
              "Invalid callback secret",
          });
        }
      }

      const body =
        req.body || {};

      const merchantTradeNo =
        body.order_id ||
        body.orderId ||
        body.merchantTradeNo ||
        body.merchant_trade_no ||
        body.reference ||
        body.transaction_id;

      if (!merchantTradeNo) {
        return res.status(400).json({
          ok: false,
          error:
            "Payment/order ID missing",
        });
      }

      const status =
        normalizePaymentStatus(
          body.status ||
            body.payment_status ||
            body.paymentStatus ||
            body.state
        );

      const payments =
        readJson(
          PAYMENTS_FILE,
          []
        );

      const index =
        payments.findIndex(
          (payment) =>
            payment.merchantTradeNo ===
              merchantTradeNo ||
            payment.paymentId ===
              merchantTradeNo ||
            payment.id ===
              merchantTradeNo
        );

      if (index === -1) {
        console.warn(
          "Unknown GatePay payment:",
          merchantTradeNo
        );

        return res.status(404).json({
          ok: false,
          error:
            "Payment not found",
        });
      }

      payments[index] = {
        ...payments[index],

        status,

        gatewayResponse:
          body,

        updatedAt:
          new Date().toISOString(),
      };

      writeJson(
        PAYMENTS_FILE,
        payments
      );

      if (
        status === "paid"
      ) {
        await finalizePaidOrder(
          payments[index]
        );
      }

      res.json({
        ok: true,
        received: true,
        status,
      });
    } catch (error) {
      console.error(
        "GATEPAY CALLBACK ERROR:",
        error
      );

      res.status(500).json({
        ok: false,
        error: error.message,
      });
    }
  }
);

// ============================================================
// PAYMENT STATUS
// ============================================================

app.get(
  "/api/payment/gatepay/status",
  (req, res) => {
    const id =
      req.query.paymentId ||
      req.query.orderId ||
      req.query.order_id;

    if (!id) {
      return res.status(400).json({
        ok: false,
        error:
          "paymentId or orderId is required",
      });
    }

    const payments =
      readJson(
        PAYMENTS_FILE,
        []
      );

    const payment =
      payments.find(
        (item) =>
          item.id === id ||
          item.paymentId === id ||
          item.merchantTradeNo === id
      );

    if (!payment) {
      return res.status(404).json({
        ok: false,
        error:
          "Payment not found",
      });
    }

    res.json({
      ok: true,

      paymentId:
        payment.paymentId,

      merchantTradeNo:
        payment.merchantTradeNo,

      provider:
        payment.provider,

      status:
        payment.status,

      amount:
        payment.amount,

      currency:
        payment.currency,

      createdAt:
        payment.createdAt,

      updatedAt:
        payment.updatedAt,
    });
  }
);

